<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Story #239: refresh the roadmap page every 15 minutes. /usr/local/bin/python3 (universal 3.13), like the other LaunchAgents on this Mac:
     the Command Line Tools python is blocked by macOS from reading ~/Documents under launchd ("Operation not permitted", 25 Oct 2026).
     Install: cp ops/launchd/com.goserve.roadmap.plist ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.goserve.roadmap.plist
     Remove:  launchctl bootout gui/$(id -u)/com.goserve.roadmap -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.goserve.roadmap</string>
  <key>ProgramArguments</key>
  <array><string>/usr/local/bin/python3</string><string>/Users/satvikjain/Documents/GoServe/scripts/roadmap.py</string></array>
  <key>WorkingDirectory</key><string>/Users/satvikjain/Documents/GoServe</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/goserve-roadmap.log</string>
  <key>StandardErrorPath</key><string>/tmp/goserve-roadmap.log</string>
</dict>
</plist>
