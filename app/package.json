{
  "name": "goserve-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GoServe product app: one installable PWA for customer, kitchen, rider and ops",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "playwright test -c playwright.live.config.ts",
    "verify": "npm run lint && npm run test:unit && npm run build",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:rehearsal": "playwright test -c playwright.rehearsal.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "leaflet": "1.9.4",
    "posthog-js": "1.438.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
