---
import "../styles/tailwind.css";
import "../styles/fonts.css";
import "../styles/ink.css";
import "../styles/site.css";
import SiteNav from "../islands/SiteNav";
import Footer from "../components/Footer.astro";
import ScrollProgress from "../islands/ScrollProgress";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "GoServe cooks hot meals in its own kitchen and brings them to your door in 25 to 35 minutes. Delhi pilot. Cash at the door.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · GoServe</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} · GoServe`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#e4e6d9" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/bricolage-grotesque-latin-1.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/anek-latin-latin-0.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-mono-latin-2.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="site" data-theme="day">
      <a class="skip-link" href="#main">Skip to content</a>
      <ScrollProgress client:idle />
      <SiteNav client:idle current={Astro.url.pathname.replace(/\/$/, "") || "/"} />
      <main id="main" class="site-main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
