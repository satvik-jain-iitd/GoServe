---
import Base from "../layouts/Base.astro";
import { Card } from "@/components/ui/card";
import Reveal from "../islands/Reveal";
import AnimatedNumber from "../islands/AnimatedNumber";
import TextEffect from "../islands/TextEffect";
import Tilt from "../islands/Tilt";
import Spotlight from "../islands/Spotlight";
import Slider from "../islands/Slider";

const phones = [
  ["phone-pin.webp", "Pin code screen", "01 · Pin code"],
  ["phone-menu.webp", "Menu", "02 · Today's thali"],
  ["phone-slip.webp", "Tracker", "06 · The slip"],
  ["phone-kitchen.webp", "Kitchen tickets", "Kitchen · New tickets"],
  ["phone-rider.webp", "Rider pick up", "Rider · Pick up"],
  ["phone-night.webp", "Menu at night", "Night · 6 pm to 6 am"],
];
---
<Base title="How it works" description="GoServe cooks hot meals in its own kitchen and brings them to your door in 25 to 35 minutes. Delhi pilot. Cash at the door. No app to install.">
  <section class="hero" aria-label="Hot meals from our kitchen">
    <div class="blob" aria-hidden="true"></div>
    <div class="wrap">
      <div class="copy">
        <span class="eyebrow">Delhi pilot · hot meals · cash at the door</span>
        <TextEffect client:idle text="Hot meals from our kitchen. At your door in 25 to 35 minutes." className="display xl" />
        <p class="lead">One thali, cooked today, carried a short way by a rider who knows your lane. No app to install. No card. Pay cash when it arrives.</p>
        <form class="pinform" action="/pre-register" method="get" aria-label="Check your pin code">
          <label for="pin" class="eyebrow" style="position: absolute; left: -9999px;">Your pin code</label>
          <input id="pin" name="pin" type="tel" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" placeholder="110024" />
          <button type="submit" class="ui-btn big" style="width: auto; padding: 0 28px;">See if we deliver</button>
        </form>
        <span class="mono" style="font-size: 12px; color: var(--gs-text-muted); text-transform: uppercase;">We serve a few pin codes for now. We add more every week.</span>
      </div>
      <div class="art"><Tilt client:visible><div class="phone"><img src="/site-img/phone-menu.webp" alt="The GoServe menu on a phone: today's thali, then the extras" width="280" height="606" fetchpriority="high" loading="eager" decoding="async" /></div></Tilt></div>
    </div>
  </section>
  <div class="strip" aria-label="Today">
    <div class="wrap"><span>Today</span><span><b><AnimatedNumber client:visible value={1} /></b> kitchen live in Delhi</span><span><b>25 to 35</b> min to the door</span><span>Cash at the door</span><span>No app to install</span></div>
  </div>
  <section class="section" aria-label="Today's thali">
    <div class="wrap">
      <div class="sec-head"><span class="eyebrow">Today's thali</span><h2 class="display l">The plate that arrives.</h2><p class="lead">One veg plate and one non-veg plate, set by the kitchen each day. On the day, the photo in the app is the real plate. Dishes beyond the thali are extras.</p><div class="ui-zigzag" aria-hidden="true"></div></div>
      <div class="thali">
        <Reveal client:visible>
          <Card className="card">
            <div class="photo"><img src="/site-img/thali-veg.webp" alt="Veg thali" loading="lazy" width="720" height="411" /></div>
            <div class="body"><span class="eyebrow">Veg · serves 1</span><h3 class="display m">Veg thali</h3><p style="margin: 0; color: var(--gs-text-muted);">Roti, a dal, a sabzi and salad. What is on the plate changes with the day.</p><span class="eyebrow">Price set by the kitchen each day · cash at the door</span></div>
          </Card>
        </Reveal>
        <Reveal client:visible delay={0.1}>
          <Card className="card">
            <div class="photo"><img src="/site-img/thali-nonveg.webp" alt="Non-veg thali" loading="lazy" width="720" height="411" /></div>
            <div class="body"><span class="eyebrow">Non-veg · serves 1</span><h3 class="display m">Non-veg thali</h3><p style="margin: 0; color: var(--gs-text-muted);">Roti, a chicken or egg curry, a dal and salad. What is on the plate changes with the day.</p><span class="eyebrow">Price set by the kitchen each day · cash at the door</span></div>
          </Card>
        </Reveal>
      </div>
    </div>
  </section>
  <section class="section" id="how" aria-label="How it works">
    <div class="wrap">
      <div class="sec-head"><span class="eyebrow">How it works</span><h2 class="display l">Three moves. One hot plate.</h2><div class="ui-zigzag" aria-hidden="true"></div></div>
      <div class="cards">
        <Reveal client:visible><Card className="card"><span class="num">01</span><h3>Pick your thali</h3><p>Type your pin code. See today's plate. Tap once. Your name, phone and address stay on your phone, no sign in.</p></Card></Reveal>
        <Reveal client:visible delay={0.1}><Card className="card"><span class="num">02</span><h3>The system picks the kitchen and the rider</h3><p>Our kitchen nearest to you gets the ticket. The nearest free rider gets the job. Nobody guesses; the system decides in a second.</p></Card></Reveal>
        <Reveal client:visible delay={0.2}><Card className="card"><span class="num">03</span><h3>Hot at your door. Pay cash.</h3><p>Cooked today, carried a short way. You watch the status on one slip: cooking, ready, on the way, delivered.</p></Card></Reveal>
      </div>
    </div>
  </section>
  <section class="section" aria-label="The product">
    <div class="wrap">
      <div class="sec-head"><span class="eyebrow">The product</span><h2 class="display l">One app. Four hands.</h2><p class="lead">Customer, kitchen, rider and admin run on one codebase. Day and Night by the clock.</p><div class="ui-zigzag" aria-hidden="true"></div></div>
      <Slider client:visible>
        {phones.map(([src, alt, cap]) => (
          <figure><div class="phone"><img src={`/site-img/${src}`} alt={alt} loading="lazy" width="220" height="476" /></div><figcaption>{cap}</figcaption></figure>
        ))}
      </Slider>
    </div>
  </section>
  <div class="waves" aria-hidden="true"></div>
  <section class="section" style="background: var(--md-surface); border-top: 0;" aria-label="Why GoServe">
    <div class="wrap">
      <div class="sec-head"><span class="eyebrow">Why it is hot</span><h2 class="display l">Small promises we can keep.</h2><div class="ui-zigzag" aria-hidden="true"></div></div>
      <div class="cards four">
        <Card className="card"><h3>A short way</h3><p>Our kitchen serves a few pin codes around it. Short trips keep the food hot.</p></Card>
        <Card className="card"><h3>Honest minutes</h3><p>25 to 35 minutes is what we do today. We say it before you order, not after.</p></Card>
        <Card className="card"><h3>Cash at the door</h3><p>No card, no wallet, no sign in. Pay the rider when the plate is in your hand.</p></Card>
        <Card className="card"><h3>Nothing to install</h3><p>It runs in the browser. Save it to your home screen if you like.</p></Card>
      </div>
    </div>
  </section>
  <section class="band" style="position: relative;" aria-label="For investors">
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap" style="position: relative;">
      <Spotlight client:visible>
        <div style="display: flex; flex-direction: column; gap: 20px;">
          <span class="eyebrow">For investors</span>
          <h2 class="display l" style="color: #e8ecf5;">GoServe runs the kitchen. The system runs the city.</h2>
          <p class="lead">Hot meals as quick commerce: one kitchen per few pin codes, one codebase for every role, decisions made by small models, not by people on phones. A Delhi pilot today. Ten kitchens next.</p>
          <div style="display: flex; gap: 12px; flex-wrap: wrap;"><a href="/investors" class="ui-btn big" style="width: auto; padding: 0 28px;">Read the model</a><a href="/investors#ask" class="ui-btn ghost big" style="width: auto; padding: 0 28px;">Talk to us</a></div>
        </div>
      </Spotlight>
      <div style="display: flex; justify-content: center;"><div class="phone"><img src="/site-img/phone-first-night.webp" alt="GoServe first screen at night" loading="lazy" width="280" height="606" /></div></div>
    </div>
  </section>
  <section class="section" aria-label="Pre-register">
    <div class="wrap" style="display: flex; flex-direction: column; gap: 20px; align-items: flex-start;">
      <span class="eyebrow">Your pin code next</span>
      <h2 class="display l">Get in before the first order in your lane.</h2>
      <p class="lead">Tell us your pin code. When our kitchen reaches it, you hear first.</p>
      <a href="/pre-register" class="ui-btn big" style="width: auto; padding: 0 28px;">Pre-register your pin code</a>
    </div>
  </section>
</Base>
