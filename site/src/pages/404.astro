---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found">
  <section class="section">
    <div class="wrap notfound">
      <span class="eyebrow">404</span>
      <h1 class="display xl">This page went out for delivery.</h1>
      <p class="lead">It is not here. But everything else is. Let us take you back to the start.</p>
      <a class="ui-btn big" style="width: auto; padding: 0 28px;" href="/">Back to home</a>
    </div>
  </section>
</Base>
