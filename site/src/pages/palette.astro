---
import Base from "../layouts/Base.astro";
import Swatch from "../components/Swatch.astro";
import { GROUPS, CONTRAST_PAIRS } from "../data/palette";
import { contrastRatio, formatRatio, wcagLevel } from "../lib/color";

const m3Roles: { role: string; token: string; hex: string }[] = [
  { role: "primary", token: "var(--md-primary)", hex: "#45654E" },
  { role: "on-primary", token: "var(--md-on-primary)", hex: "#FFFFFF" },
  { role: "primary-container", token: "var(--md-primary-container)", hex: "#BFCFB4" },
  { role: "secondary", token: "var(--md-secondary)", hex: "#7F9743" },
  { role: "secondary-container", token: "var(--md-secondary-container)", hex: "#C8D888" },
  { role: "tertiary", token: "var(--md-tertiary)", hex: "#FFDE59" },
  { role: "background", token: "var(--md-background)", hex: "#E4E6D9" },
  { role: "surface", token: "var(--md-surface)", hex: "#F7F3EF" },
  { role: "on-background", token: "var(--md-on-background)", hex: "#263528" },
  { role: "error", token: "var(--md-error)", hex: "#B3261E" },
];
---
<Base title="The palette" description="The GoServe colour palette, extracted from the investor deck, with contrast ratios and Material 3 roles.">
  <section class="section" style="padding-bottom: var(--gs-space-6)">
    <div class="container container-narrow">
      <span class="eyebrow">From the deck, to the pixel</span>
      <h1 class="h1">This is the palette.</h1>
      <p class="lead">
        Every colour on this site comes from the GoServe investor deck. We read
        each page twice: once from the vector layer, once from the pixels. Nothing
        here is invented. Cream is the canvas. Deep green is the action. Ink is the
        voice. Lime and warm yellow are the rare pops.
      </p>
    </div>
  </section>

  {
    GROUPS.map((group) => (
      <section class="section" style="padding-block: var(--gs-space-7)">
        <div class="container">
          <h2 class="h2" style="margin-bottom: var(--gs-space-2)">{group.title}</h2>
          <p class="muted" style="margin-bottom: var(--gs-space-6)">{group.note}</p>
          <div class="sw-grid">
            {group.swatches.map((s) => <Swatch swatch={s} />)}
          </div>
        </div>
      </section>
    ))
  }

  <!-- CONTRAST -->
  <section class="section section--sage">
    <div class="container">
      <span class="eyebrow">Accessibility</span>
      <h2 class="h2" style="margin-bottom: var(--gs-space-6)">Contrast, proved, not guessed.</h2>
      <div class="card" style="overflow-x:auto">
        <table class="ct">
          <thead>
            <tr><th scope="col">Pair</th><th scope="col">Ratio</th><th scope="col">WCAG</th></tr>
          </thead>
          <tbody>
            {
              CONTRAST_PAIRS.map((p) => {
                const ratio = contrastRatio(p.fg, p.bg);
                const level = wcagLevel(ratio);
                return (
                  <tr>
                    <th scope="row">
                      <span class="ct-dot" style={`background:${p.bg};border-color:${p.fg}`} aria-hidden="true"></span>
                      {p.label}
                    </th>
                    <td><strong>{formatRatio(ratio)}</strong></td>
                    <td><span class={`badge ${level === "Fail" ? "badge--wip" : "badge--live"}`}>{level}</span></td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
      <p class="muted" style="margin-top: var(--gs-space-4)">
        AAA is 7:1 or more for body text. AA is 4.5:1. Our body pairs sit well above the bar.
      </p>
    </div>
  </section>

  <!-- M3 ROLES -->
  <section class="section">
    <div class="container">
      <span class="eyebrow">Material Design 3</span>
      <h2 class="h2" style="margin-bottom: var(--gs-space-6)">The roles they play.</h2>
      <div class="m3-grid">
        {
          m3Roles.map((r) => (
            <div class="m3">
              <div class="m3-chip" style={`background:${r.token}`} aria-hidden="true"></div>
              <code>{r.role}</code>
              <span class="muted">{r.hex}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- LIVE COMPONENTS -->
  <section class="section section--surface">
    <div class="container">
      <span class="eyebrow">In use</span>
      <h2 class="h2" style="margin-bottom: var(--gs-space-6)">The same colours, live.</h2>
      <div class="demo-grid">
        <div class="card">
          <h3 class="h3">Buttons</h3>
          <div class="row">
            <button class="btn btn--primary" type="button">Primary</button>
            <button class="btn btn--secondary" type="button">Secondary</button>
            <button class="btn btn--ghost" type="button">Ghost</button>
          </div>
        </div>
        <div class="card">
          <h3 class="h3">Status</h3>
          <div class="row">
            <span class="badge badge--live">Ready</span>
            <span class="badge badge--soon">Cooking</span>
            <span class="badge badge--wip">Placed</span>
          </div>
        </div>
        <div class="card">
          <h3 class="h3">Surfaces</h3>
          <div class="row">
            <div class="surf" style="background: var(--gs-cream)">Cream</div>
            <div class="surf" style="background: var(--gs-sage)">Sage</div>
            <div class="surf" style="background: var(--gs-off-white)">Off white</div>
          </div>
        </div>
      </div>
      <p class="muted" style="margin-top: var(--gs-space-6)">
        Want the raw values? They live in <code>docs/design-tokens.md</code> and
        <code>site/src/styles/tokens.css</code>. There is also a flat preview:
        <a href="/assets/palette.png">palette.png</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .sw-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--gs-space-5);
  }
  .ct {
    width: 100%;
    border-collapse: collapse;
    min-width: 30rem;
  }
  .ct th,
  .ct td {
    text-align: left;
    padding: var(--gs-space-3) var(--gs-space-4);
    border-bottom: 1px solid var(--gs-sage);
  }
  .ct tbody th {
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: var(--gs-space-3);
  }
  .ct-dot {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 3px solid;
    display: inline-block;
  }
  .m3-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--gs-space-4);
  }
  .m3 {
    display: grid;
    gap: var(--gs-space-2);
  }
  .m3-chip {
    height: 56px;
    border-radius: var(--gs-radius-m);
    border: 1px solid var(--gs-ink-green);
  }
  .m3 code {
    font-weight: 700;
    color: var(--gs-ink-green);
  }
  .demo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--gs-space-5);
  }
  .row {
    display: flex;
    gap: var(--gs-space-3);
    flex-wrap: wrap;
    align-items: center;
    margin-top: var(--gs-space-4);
  }
  .h3 {
    font-size: var(--gs-text-lg);
  }
  .surf {
    padding: var(--gs-space-3) var(--gs-space-4);
    border-radius: var(--gs-radius-s);
    border: 1px solid var(--gs-sage);
    font-weight: 600;
  }
</style>
