---
import Base from "../layouts/Base.astro";
import PreRegisterForm from "../components/PreRegisterForm.astro";
---
<Base title="Pre-register" description="Tell GoServe your pin code and who you are. Customers hear first when the kitchen reaches them. Cooks and riders hear when we hire near them.">
  <section class="section" aria-label="Pre-register">
    <div class="wrap split">
      <div style="display: flex; flex-direction: column; gap: 20px;">
        <span class="eyebrow">Pre-register</span>
        <h1 class="display xl">Get in before the first order in your lane.</h1>
        <p class="lead">We add pin codes every week. Tell us yours and who you are. Customers hear first when the kitchen reaches them. Cooks and riders hear when we hire near them.</p>
        <div class="ui-zigzag" aria-hidden="true" style="width: 96px;"></div>
        <span class="mono" style="font-size: 12px; color: var(--gs-text-muted); text-transform: uppercase;">No spam. One message when it matters.</span>
      </div>
      <PreRegisterForm />
    </div>
  </section>
</Base>
