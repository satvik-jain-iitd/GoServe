---
import type { Swatch } from "../data/palette";
import { contrastRatio, formatRatio, readableInk } from "../lib/color";

interface Props {
  swatch: Swatch;
}

const { swatch } = Astro.props;
// Contrast of the swatch against white and against the cream canvas.
const onWhite = formatRatio(contrastRatio(swatch.hex, "#FFFFFF"));
const onCream = formatRatio(contrastRatio(swatch.hex, "#E4E6D9"));
const ink = readableInk(swatch.hex);
---
<div class="sw">
  <div class="sw-chip" style={`background:${swatch.hex};color:${ink}`}>
    <span class="sw-chip-name">{swatch.name}</span>
  </div>
  <div class="sw-meta">
    <code>{swatch.hex.toUpperCase()}</code>
    <p class="sw-usage">{swatch.usage}</p>
    <p class="sw-contrast">
      vs white {onWhite} · vs cream {onCream}
    </p>
  </div>
</div>

<style>
  .sw {
    border: 1px solid var(--gs-ink-green);
    border-radius: var(--gs-radius-m);
    overflow: hidden;
    background: var(--gs-off-white);
  }
  .sw-chip {
    min-height: 110px;
    display: flex;
    align-items: flex-end;
    padding: var(--gs-space-4);
  }
  .sw-chip-name {
    font-weight: 800;
    font-size: 1.25rem;
  }
  .sw-meta {
    padding: var(--gs-space-4);
  }
  .sw-meta code {
    font-size: var(--gs-text-sm);
    font-weight: 700;
    color: var(--gs-deep-green);
  }
  .sw-usage {
    margin: var(--gs-space-2) 0;
    font-size: var(--gs-text-sm);
  }
  .sw-contrast {
    margin: 0;
    font-size: var(--gs-text-xs);
    color: var(--gs-text-muted);
  }
</style>
